# ME Lab — Environment Configuration Example
# Copy to .env for local development: cp .env.example .env
# NEVER commit .env or real secrets to version control.

# HTTP Server
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite Persistence
# In production on Azure VM, point this to the persistent Managed Disk mount:
# DATABASE_URL=/mnt/melab-data/me-lab.db
DATABASE_URL=./me-lab.db
DB_BUSY_TIMEOUT_MS=5000

# Authentication (Argon2id + HMAC-SHA256 JWT)
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-bytes-of-cryptographic-randomness
JWT_EXPIRY_HOURS=24

# Azure Blob Storage Backups (used by scripts/backup-sqlite.sh)
AZURE_STORAGE_ACCOUNT=melabbackupsplaceholder
AZURE_STORAGE_CONTAINER=sqlite-backups
# Prefer Managed Identity (`AZURE_USE_MANAGED_IDENTITY=true`) on the Azure VM;
# SAS token is only for local/manual restore testing.
AZURE_USE_MANAGED_IDENTITY=true
AZURE_STORAGE_SAS_TOKEN=
