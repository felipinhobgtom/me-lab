[
  {
    "id": "ae2:pattern_provider",
    "name": "ME Pattern Provider",
    "category": "autocrafting",
    "behavior_key": "pattern_provider",
    "fidelity": "exact",
    "doc_reference": "https://guide.appliedenergistics.org/1.21.1/items-blocks-machines/pattern_provider",
    "metadata": {
      "channel_usage": 1,
      "channel_capacity": 8,
      "transmits_channels": true,
      "is_cable": false,
      "is_smart_cable": false,
      "is_dense_cable": false,
      "energy_cost": 1,
      "energy_capacity": 25,
      "energy_generation": 0,
      "rotatable": true,
      "description": "Holds encoded crafting and processing patterns, pushing ingredients to adjacent Molecular Assemblers or machines.",
      "connection_rules": {
        "connect_all_faces": true,
        "disconnect_push_face": true
      },
      "config_schema": [
        {
          "key": "priority",
          "label": "Crafting Priority",
          "type": "number",
          "default": 0,
          "description": "Higher-priority providers are selected first when multiple patterns produce the same item."
        },
        {
          "key": "variant",
          "label": "Provider Variant",
          "type": "select",
          "default": "normal",
          "options": ["normal", "directional"],
          "description": "Directional pushes only on Facing and disconnects ME network on that push face."
        },
        {
          "key": "blocking_mode",
          "label": "Blocking Mode",
          "type": "boolean",
          "default": false,
          "description": "Wait to push ingredients while target machine already holds active batch items."
        },
        {
          "key": "lock_mode",
          "label": "Lock Crafting Mode",
          "type": "select",
          "default": "none",
          "options": ["none", "until_result_returned"],
          "description": "When locked until result returned, blocks subsequent batches until primary output returns."
        },
        {
          "key": "patterns",
          "label": "Encoded Patterns",
          "type": "patterns",
          "description": "Crafting and processing patterns stored in this Pattern Provider."
        }
      ],
      "visual": {
        "color": "#312e81",
        "accent_color": "#fbbf24",
        "shape": "cube",
        "size": [1.0, 1.0, 1.0]
      }
    }
  },
